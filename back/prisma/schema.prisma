// back/prisma/schema.prisma

// npx prisma migrate dev --name описание
// npx prisma migrate reset - удаляет ВСЕ таблицы
// npx prisma generate - пересобирает Prisma Client

// npx prisma studio -  запускает веб-интерфейс
// Поднимается локальный сервер (по умолчанию http://localhost:5555)
// Автоматически открывается браузер с интерфейсом Studio
// Prisma читает ваш schema.prisma и подключается к БД через DATABASE_URL из .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id        String   @id @default(cuid()) // уникальный идентификатор записи
  symbol    String // тикер актива
  type      String // BUY / SELL
  amount    Float // количество
  price     Float // цена на момент сделки
  createdAt DateTime @default(now()) // момент события
}

model Coin {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique // тикер (BTC, ETH)
  geckoId   String   @unique // идентификатор CoinGecko
  name      String? // полное название (опционально)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
}

model PortfolioSnapshot {
  id          String   @id @default(cuid())
  timestamp   DateTime // момент фиксации стоимости
  granularity String // '1h' | '1d' | '1w' | '1m'
  totalValue  Float // общая стоимость портфеля в USD

  @@index([granularity, timestamp]) // составной индекс для range-запросов
  @@map("portfolio_snapshots")
}
