// npx prisma migrate dev
// npx prisma generate
// npx prisma studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id        String   @id @default(cuid()) // уникальный идентификатор записи
  symbol    String // тикер
  type      String // BUY / SELL
  amount    Float // количество
  price     Float // цена
  createdAt DateTime @default(now()) // момент события
}
