
# Скопируй этот файл в .env и заполни реальными значениями: cp .env.example .env

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=crypto_db

# ==========================================
# CACHE (Redis)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Сгенерируй: openssl rand -base64 32
JWT_SECRET=generate_long_random_string_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ==========================================
# FRONTEND URL
# ==========================================
# Для разработки: http://localhost:5173
# Для production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ==========================================
# YANDEX OAUTH
# ==========================================
# Получи на: https://oauth.yandex.ru/
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
# Для разработки: http://localhost:3000/auth/yandex/callback
# Для production: https://api.yourdomain.com/auth/yandex/callback
YANDEX_CALLBACK_URL=http://localhost:3000/auth/yandex/callback

# ==========================================
# EMAIL (Resend)
# ==========================================
# Получи на: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="Your App <noreply@yourdomain.com>"
PASSWORD_RESET_TTL=3600

# ==========================================
# MARKET DATA PROVIDER
# ==========================================
# Варианты: coingecko или coinlore
MARKET_DATA_PROVIDER=coinlore

# CoinGecko (опционально)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=your_coingecko_api_key

# CoinLore (опционально)
COINLORE_BASE_URL=https://api.coinlore.net/api

# ==========================================
# NODE ENVIRONMENT
# ==========================================
# Варианты: development, production, test
NODE_ENV=development
