# ============================================
# Dockerfile для РАЗРАБОТКИ фронтенда (Vite + React)
# ============================================

FROM node:22-alpine

# Рабочая директория
WORKDIR /app

# Копируем ТОЛЬКО файлы зависимостей (кэш Docker)
COPY package*.json ./

# Устанавливаем ВСЕ зависимости (включая devDependencies для hot-reload)
# npm ci — детерминированная установка из package-lock.json
RUN npm ci

# Копируем весь остальной код (будет перезаписан через volume)
COPY . .

# Vite dev-сервер слушает на этом порту
EXPOSE 5173

# Запускаем Vite в режиме разработки
# --host 0.0.0.0 — чтобы был доступен извне контейнера
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
